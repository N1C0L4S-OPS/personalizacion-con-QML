#!/usr/bin/env python3
"""themegen-apps - lleva la paleta del fondo a las aplicaciones (no a los navegadores).

Genera desde ~/.cache/hyprshell/colors.json:
  ~/.themes/hyprshell/                 tema GTK3 = ARK-Dark recoloreado (css + imagenes)
  ~/.local/share/icons/Hyprshell/      iconos = Flat-Remix-Green-Dark con carpetas recoloreadas
  ~/.config/qt6ct/colors/hyprshell.conf  paleta Qt (Dolphin, Wireshark...)
Recoloreado en OKLCH: grises -> tonos del fondo, azules -> acento, rojos/naranjas -> rojo/amarillo.
Lo lanza themegen al cambiar el fondo; tambien se puede ejecutar a mano.
"""
import json, os, re, shutil, sys
from pathlib import Path
import numpy as np
from PIL import Image

HOME = Path.home()
PAL = json.loads((HOME / ".cache/hyprshell/colors.json").read_text())
SRC_GTK = Path("/usr/share/themes/ARK-Dark/gtk-3.22")
SRC_ICONS = Path("/usr/share/icons/Flat-Remix-Green-Dark")
OUT_GTK = HOME / ".themes/hyprshell"
OUT_ICONS = HOME / ".local/share/icons/Hyprshell"
QT_COLORS = HOME / ".config/qt6ct/colors/hyprshell.conf"


# ---------------- color: sRGB <-> OKLCH (vectorizado) ----------------
def _lin(c): return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
def _gam(c): return np.where(c <= 0.0031308, 12.92 * c, 1.055 * np.power(np.clip(c, 0, None), 1 / 2.4) - 0.055)

def to_lch(rgb):
    r, g, b = np.moveaxis(_lin(rgb), -1, 0)
    l = np.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
    m = np.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
    s = np.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, np.hypot(A, B), np.degrees(np.arctan2(B, A)) % 360

def to_rgb(L, C, h):
    a, b = C * np.cos(np.radians(h)), C * np.sin(np.radians(h))
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    rgb = np.stack([4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
                    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
                    -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s], -1)
    return np.clip(_gam(np.clip(rgb, 0, 1)), 0, 1)

def hex2rgb(h): return np.array([int(h[i:i + 2], 16) for i in (1, 3, 5)]) / 255.0

def lch_of(hexc):
    L, C, h = to_lch(hex2rgb(hexc)[None]); return float(L[0]), float(C[0]), float(h[0])

bgL, bgC, bgH = lch_of(PAL["bg"])
acL, acC, acH = lch_of(PAL["accent"])
_, rdC, rdH = lch_of(PAL["red"])
_, ylC, ylH = lch_of(PAL["yellow"])
_, gnC, gnH = lch_of(PAL["green"])
tint = min(max(bgC, 0.004), 0.02)

def hue_dist(a, b):
    d = np.abs(a - b) % 360
    return np.minimum(d, 360 - d)

def remap(rgb):
    """rgb (...,3) en 0..1 -> rgb recoloreado. Arc: grises azulados + acento azul #5294e2."""
    L, C, h = to_lch(rgb)
    nL, nC, nH = L.copy(), C.copy(), h.copy()
    neutral = C < 0.045
    # Grises: oscurece el rango de fondos de Arc (0.22-0.47) hacia los fondos de la paleta
    dark = neutral & (L < 0.5)
    nL = np.where(dark, bgL + (L - 0.22) * (0.34 - bgL) / (0.47 - 0.22), nL)
    nL = np.where(dark & (L < 0.22), bgL * L / 0.22, nL)
    nC = np.where(neutral, np.minimum(C * 0.3 + tint, 0.03), nC)
    nH = np.where(neutral, bgH, nH)
    chroma = ~neutral
    blue = chroma & (hue_dist(h, 245) < 45)                     # acento de Arc
    red = chroma & (hue_dist(h, 25) <= 20)
    orange = chroma & (hue_dist(h, 55) < 25) & ~red
    green = chroma & (hue_dist(h, 150) < 40)
    nH = np.where(blue, acH, nH); nC = np.where(blue, C / 0.13 * acC, nC)
    nH = np.where(red, rdH, nH); nC = np.where(red, np.minimum(C, rdC * 1.4), nC)
    nH = np.where(orange, ylH, nH); nC = np.where(orange, np.minimum(C, ylC * 1.3), nC)
    nH = np.where(green, gnH, nH)
    return to_rgb(np.clip(nL, 0, 1), np.clip(nC, 0, 0.35), nH)

def remap_hex(hexc):
    out = remap(hex2rgb(hexc)[None])[0]
    return "#" + "".join(f"{round(v * 255):02x}" for v in out)


# ---------------- GTK ----------------
def gtk():
    tmp = OUT_GTK.with_name("hyprshell.tmp")
    shutil.rmtree(tmp, ignore_errors=True)
    (tmp / "gtk-3.0/assets").mkdir(parents=True)
    css = (SRC_GTK / "gtk.css").read_text()
    cache = {}
    def sub_hex(m):
        h = m.group(0).lower()
        if len(h) == 4: h = "#" + "".join(c * 2 for c in h[1:])
        if h not in cache: cache[h] = remap_hex(h)
        return cache[h]
    def sub_rgba(m):
        r, g, b = (int(float(x)) for x in m.group(1, 2, 3))
        h = "#%02x%02x%02x" % (r, g, b)
        if h not in cache: cache[h] = remap_hex(h)
        n = cache[h]
        return f"rgba({int(n[1:3], 16)}, {int(n[3:5], 16)}, {int(n[5:7], 16)}, {m.group(4)})"
    css = re.sub(r"#[0-9a-fA-F]{6}\b|#[0-9a-fA-F]{3}\b", sub_hex, css)
    css = re.sub(r"rgba\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*([\d.]+)\s*\)", sub_rgba, css)
    (tmp / "gtk-3.0/gtk.css").write_text(css)
    (tmp / "gtk-3.0/gtk-dark.css").write_text(css)
    for png in (SRC_GTK / "assets").glob("*.png"):
        im = Image.open(png).convert("RGBA")
        a = np.asarray(im, dtype=np.float64)
        rgb = remap(a[..., :3] / 255.0)
        Image.fromarray(np.dstack([rgb * 255, a[..., 3]]).round().astype(np.uint8), "RGBA").save(tmp / "gtk-3.0/assets" / png.name)
    (tmp / "index.theme").write_text("[Desktop Entry]\nType=X-GNOME-Metatheme\nName=hyprshell\nComment=ARK-Dark recoloreado con la paleta del fondo\n\n[X-GNOME-Metatheme]\nGtkTheme=hyprshell\nIconTheme=Hyprshell\n")
    shutil.rmtree(OUT_GTK, ignore_errors=True)
    tmp.rename(OUT_GTK)


# ---------------- Iconos: carpetas con el acento ----------------
def icons():
    tmp = OUT_ICONS.with_name("Hyprshell.tmp")
    shutil.rmtree(tmp, ignore_errors=True)
    dst = tmp / "places/scalable"; dst.mkdir(parents=True)
    src = SRC_ICONS / "places/scalable"
    cache = {}
    def sub(m):
        h = m.group(0).lower()
        if h not in cache:
            L, C, hh = lch_of(h)
            # Solo los verdes de Flat-Remix-Green pasan al acento (manteniendo su luz)
            if C > 0.04 and hue_dist(np.array(hh), 170) < 45:
                out = to_rgb(np.array(L), np.array(C / 0.11 * acC), np.array(acH))
                cache[h] = "#" + "".join(f"{round(v * 255):02x}" for v in out)
            else:
                cache[h] = h
        return cache[h]
    for f in src.iterdir():
        if f.is_symlink():
            os.symlink(os.readlink(f), dst / f.name)
        elif f.suffix == ".svg":
            (dst / f.name).write_text(re.sub(r"#[0-9a-fA-F]{6}\b", sub, f.read_text()))
    (tmp / "index.theme").write_text(
        "[Icon Theme]\nName=Hyprshell\nComment=Flat-Remix con carpetas en el acento del fondo\n"
        "Inherits=Flat-Remix-Green-Dark,breeze-dark,hicolor\nDirectories=places/scalable\n\n"
        "[places/scalable]\nContext=Places\nSize=48\nMinSize=16\nMaxSize=512\nType=Scalable\n")
    shutil.rmtree(OUT_ICONS, ignore_errors=True)
    tmp.rename(OUT_ICONS)


# ---------------- Qt (qt6ct) ----------------
def qt():
    p = PAL
    hl_txt = p["bg"]
    # Orden de qt6ct: WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText, ButtonText, Base,
    # Window, Shadow, Highlight, HighlightedText, Link, LinkVisited, AlternateBase, NoRole, ToolTipBase,
    # ToolTipText, PlaceholderText
    active = [p["fg"], p["surface2"], p["overlay"], p["surface2"], p["bg"], p["surface"], p["fg"], "#ffffff",
              p["fg"], p["surface"], p["bg"], "#000000", p["accent"], hl_txt, p["accent"], p["accent2"],
              p["surface2"], p["bg"], p["surface2"], p["fg"], p["fgDim"]]
    disabled = list(active)
    for i in (0, 6, 8): disabled[i] = p["fgDim"]
    disabled[12] = p["overlay"]
    line = lambda c: ", ".join("#ff" + x.lstrip("#") for x in c)
    QT_COLORS.parent.mkdir(parents=True, exist_ok=True)
    QT_COLORS.write_text(f"[ColorScheme]\nactive_colors={line(active)}\ndisabled_colors={line(disabled)}\ninactive_colors={line(active)}\n")


if __name__ == "__main__":
    parts = sys.argv[1:] or ["gtk", "icons", "qt"]
    for part in parts:
        {"gtk": gtk, "icons": icons, "qt": qt}[part]()
    print("themegen-apps: listo (" + ", ".join(parts) + ")")
