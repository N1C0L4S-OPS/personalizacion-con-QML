// Fastfetch - banner de la terminal. Colores ANSI = paleta del fondo (themegen).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // Loro de Parrot con alas, tenido con la paleta (la genera themegen en ~/.cache/hyprshell/parrot.png)
        "type": "kitty-direct",
        "source": "~/.cache/hyprshell/parrot.png",
        "width": 33,
        "height": 15,
        "padding": { "top": 2, "left": 4, "right": 5 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "cyan", "title": "cyan", "separator": "bright_black" },
        "key": { "width": 11 },
        "bar": {
            "char": { "elapsed": "━", "total": "━" },
            "border": { "left": "", "right": "" },
            "color": { "elapsed": "cyan", "total": "90" },
            "width": 12
        },
        "percent": { "type": 3, "color": { "green": "cyan", "yellow": "yellow", "red": "red" } }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{#1}{user-name}{#}{#90} @ {#}{#1;96}{host-name}" },
        { "type": "custom", "format": "{#90}─────────────────────────────────────" },
        { "type": "os",      "key": "  os",      "format": "{name} {version-id}" },
        { "type": "kernel",  "key": "󰌽  kernel",  "format": "{release}" },
        { "type": "wm",      "key": "󰨇  wm",      "format": "{pretty-name} {version}" },
        { "type": "shell",   "key": "󰆍  shell",   "format": "{pretty-name} {version}" },
        { "type": "terminal","key": "󰞷  term",    "format": "{pretty-name} {version}" },
        { "type": "uptime",  "key": "󰄉  uptime" },
        { "type": "custom", "format": "{#90}─────────────────────────────────────" },
        { "type": "cpu",     "key": "󰻠  cpu",     "format": "{name}" },
        { "type": "gpu",     "key": "󰢮  gpu",     "format": "{name}" },
        { "type": "memory",  "key": "󰍛  memory",  "format": "{percentage-bar}  {used} / {total}" },
        { "type": "disk",    "key": "󰋊  disk",    "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total}" },
        { "type": "custom", "format": "{#90}─────────────────────────────────────" },
        {
            "type": "command", "key": "󰖂  vpn",
            "text": "ip=$(ip -4 -o addr show tun0 2>/dev/null | awk '{print $4}' | cut -d/ -f1); [ -n \"$ip\" ] && printf '\\033[32m%s\\033[0m' \"$ip\" || printf '\\033[90mdesconectado\\033[0m'"
        },
        {
            "type": "command", "key": "󰓾  target",
            "text": "f=~/.config/target_info; [ -s $f ] && awk '{printf \"\\033[1;31m%s\\033[0m  \\033[31m%s\\033[0m\", $2, $1}' $f || printf '\\033[90mninguno\\033[0m'"
        },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
